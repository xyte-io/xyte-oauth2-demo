# Copy to .env and fill in the credentials Xyte issued for your application.
# Every value below is also accepted as a plain environment variable.

# Base URL of the Xyte hub you are integrating with (no trailing slash).
# Production: https://hub.xyte.io
XYTE_HUB=http://localhost:3000

# Issued by Xyte out of band, together with the redirect URI they registered for you.
XYTE_CLIENT_ID=
XYTE_CLIENT_SECRET=

# Must match a registered redirect URI byte for byte, including the port and path.
REDIRECT_URI=http://localhost:5555/callback

# Port this demo listens on. Keep it in sync with REDIRECT_URI.
PORT=5555

# Space-separated subset of: openid profile email
SCOPE=openid profile email

# How this app authenticates to the token endpoint: basic (client_secret_basic) or post (client_secret_post).
AUTH_METHOD=basic

# Name shown in this demo's own UI. The name on the Xyte consent screen comes from the
# application record Xyte registered, not from here.
APP_NAME=Acme Fleet Portal
